{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": ["src/**/*"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "css": {
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": "off",
      "correctness": {
        "noUnusedImports": "error",
        "noChildrenProp": "off"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
