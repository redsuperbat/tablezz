{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-toggle-maximize",
    "opener:default",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-home-read-recursive",
    "fs:allow-home-meta-recursive",
    "fs:allow-watch",
    "fs:scope-home",
    "process:allow-restart"
  ]
}
