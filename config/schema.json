{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Configuration",
  "description": "All configuration options to configure Tablezz.",
  "type": "object",
  "properties": {
    "commandAliases": {
      "description": "Aliases for long named commands, e.g. { \"w\": \"WriteChanges\" }.",
      "default": {},
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "editor": {
      "description": "The terminal editor invoked when editing cells.",
      "default": "nvim",
      "type": "string"
    },
    "keybinds": {
      "description": "Custom keybinds which trigger predefined commands.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/KeybindEntry"
      }
    },
    "leaderKey": {
      "description": "The leader key, e.g. \"Space\" or \"Control + a\".",
      "default": "Space",
      "type": "string"
    }
  },
  "definitions": {
    "KeybindEntry": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "string"
            },
            "description": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    }
  }
}
